.pixel-canvas
  max-width 700px
  margin 0 auto
  padding 20px

  &__header
    margin-bottom 20px

  &__controls
    display flex
    gap 10px
    align-items center

  &__canvas-wrapper
    display flex
    justify-content center

  &__canvas
    width 640px
    height 640px
    border 1px solid #ddd
    image-rendering pixelated
    cursor crosshair
    background #fff
    box-shadow 0 4px 12px rgba(0,0,0,.08)